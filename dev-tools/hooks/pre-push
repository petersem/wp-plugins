#!/bin/bash

PLUGIN_FILE="example.php"

# Extract current version
CURRENT_VERSION=$(grep -E "^\s*\* Version:" "$PLUGIN_FILE" | awk '{print $3}')

IFS='.' read -r major minor patch <<< "$CURRENT_VERSION"

echo "Current plugin version: $CURRENT_VERSION"
echo "Select version bump type:"
echo "  1) Major"
echo "  2) Minor"
echo "  3) Patch (bugfix)"
read -p "Enter choice (1/2/3): " choice

case "$choice" in
  1)
    major=$((major + 1))
    minor=0
    patch=0
    ;;
  2)
    minor=$((minor + 1))
    patch=0
    ;;
  3)
    patch=$((patch + 1))
    ;;
  *)
    echo "Invalid choice. Aborting push."
    exit 1
    ;;
esac

NEW_VERSION="$major.$minor.$patch"

# Update plugin header
# Note: Git Bash uses GNU sed, so no BSD-style -i "" required
sed -i "s/^\s*\* Version: .*/ * Version: $NEW_VERSION/" "$PLUGIN_FILE"

# Commit the version bump
git add "$PLUGIN_FILE"
git commit -m "Bump plugin version: $CURRENT_VERSION → $NEW_VERSION"

echo "Version updated to $NEW_VERSION"
echo "Continuing push..."
